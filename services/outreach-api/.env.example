NODE_ENV=development
API_PORT=4100
API_PUBLIC_URL=http://localhost:4100
# Where the SPA lives for redirects after sign-in (Vite dev server in dev; the API's own origin in prod).
APP_PUBLIC_URL=http://localhost:5175
# Same values as services/cti-api so sessions and encrypted tokens interoperate.
TOKEN_ENCRYPTION_KEY=replace_me_with_64_hex_chars
SESSION_SECRET=replace_me_with_long_random_string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cti_dev
# Sign in with Salesforce (same External Client App as the CTI; PKCE, no secret).
SALESFORCE_CLIENT_ID=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_SIGNIN_REDIRECT_URI=http://localhost:4100/api/auth/salesforce/callback
# The company-wide Integration-user connection (Settings -> Connections) uses the same app and consumer key.
# Its callback must also be on the app's callback list.
SALESFORCE_REDIRECT_URI=http://localhost:4100/api/connections/salesforce/callback
# SALESFORCE_CLIENT_SECRET: not used (PKCE; the app has no secret). Leave it unset.
# Optional: only this Salesforce org may sign in (same value as on cti-api).
SALESFORCE_ALLOWED_ORG_ID=
# WorkOS AuthKit (dashboard -> API Keys / Configuration). Optional. Leave unset to hide the email sign-in button.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:4100/api/auth/workos/callback
# pg-boss schema in the shared Postgres.
PGBOSS_SCHEMA=pgboss
ALERT_WEBHOOK_URL=
CORS_ALLOWED_ORIGINS=
# Claude: note triage and AI call plans. Unset = both off.
ANTHROPIC_API_KEY=
CALL_PLAN_MODEL=claude-sonnet-5-5
# AI calls (plan 1C): cti-api's internal URL (an origin only; on Railway it is
# http://ctiapi.railway.internal:4000) and the shared HMAC secret (32+ chars, the same value
# as OUTREACH_INTERNAL_SECRET on cti-api). Unset = no AI calls are placed.
CTI_INTERNAL_URL=http://localhost:4000
OUTREACH_INTERNAL_SECRET=
# Plan 1D. The Claude model that maps an AI call's answers onto Salesforce fields (unset = claude-sonnet-5-5).
WRITEBACK_MODEL=claude-haiku-4-5-20251001
# Plan 1D. Comma-separated Salesforce User ids (005..., up to 20) that pre-fill the appointment owner list
# when an org has never saved its AI call settings. It only pre-fills: booking, Lead conversion and
# write-back still start off until an admin turns them on in Settings.
AI_CALL_DEFAULT_SPECIALISTS=
# Sam's email (Resend). Set both or neither; unset = Sam sends no email (old unsubscribe links still work).
# The Resend API key: sends Sam's emails and reads the replies back.
RESEND_API_KEY=
# The signing secret of the Resend webhook (Resend -> Webhooks), whsec_ followed by base64.
RESEND_WEBHOOK_SECRET=
# Optional; the defaults are shown.
# The From header of every email Sam sends (an address on the verified Resend domain).
# EMAIL_FROM="Sam at GG Homes <sam@rethinkre.team>"
# Where replies land (sam+<token>@<this>); its MX record points at Resend, never the root domain's MX.
# EMAIL_REPLY_DOMAIN=reply.rethinkre.team
# The postal address printed in every email footer.
# EMAIL_POSTAL_ADDRESS="18872 MacArthur Blvd #220, Irvine, CA 92612"
# The company named in the footer and on the unsubscribe page.
# EMAIL_COMPANY_NAME="GG Homes"
# The Claude model that drafts Sam's emails; it must be priced (an unpriced one = no writer, replies go to a person).
# EMAIL_MODEL=claude-sonnet-5-5
